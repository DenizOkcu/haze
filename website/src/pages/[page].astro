---
import Layout from "../layouts/SiteLayout.astro";
import index from "../content/index.html?raw";
import indexMeta from "../content/index.json";
import quickstart from "../content/quickstart.html?raw";
import quickstartMeta from "../content/quickstart.json";
import commands from "../content/commands.html?raw";
import commandsMeta from "../content/commands.json";
import tools from "../content/tools.html?raw";
import toolsMeta from "../content/tools.json";
import skills from "../content/skills.html?raw";
import skillsMeta from "../content/skills.json";
import workflows from "../content/workflows.html?raw";
import workflowsMeta from "../content/workflows.json";
export function getStaticPaths() { return [
  { params: { page: 'quickstart' }, props: { content: quickstart, meta: quickstartMeta } },
  { params: { page: 'commands' }, props: { content: commands, meta: commandsMeta } },
  { params: { page: 'tools' }, props: { content: tools, meta: toolsMeta } },
  { params: { page: 'skills' }, props: { content: skills, meta: skillsMeta } },
  { params: { page: 'workflows' }, props: { content: workflows, meta: workflowsMeta } }
]; }
const { content, meta } = Astro.props;
---
<Layout page={Astro.params.page} {...meta}><Fragment set:html={content} /></Layout>
