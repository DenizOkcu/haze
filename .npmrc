# Install-script enforcement (SC-10): npm has no per-package script allowlist
# (the `allowScripts` field in package.json documents intent but blocks
# nothing), so fail closed instead. The dependency trees that matter here —
# esbuild (platform binaries ship via optionalDependencies) and fsevents
# (prebuilt .node ships in the tarball) — install and build with scripts
# disabled; this package has no node-pty-style native build. Any future
# dependency that genuinely needs an install script will fail loudly here
# instead of executing silently during `npm ci`.
#
# Side effect to know: this flag also suppresses lifecycle scripts at command
# time, so a local `npm publish` from this checkout no longer runs
# `prepublishOnly`. Release publishing goes through .github/workflows/
# release.yml, which runs the full gate (typecheck/test/lint/build/audit/
# release:verify) as explicit steps before `npm publish --provenance`. For a
# manual publish, run `npm publish --ignore-scripts=false` so the local gate
# still executes.
ignore-scripts=true
