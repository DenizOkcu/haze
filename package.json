{
  "name": "@denizokcu/haze",
  "version": "1.3.0",
  "description": "A minimal LLM harness for your terminal.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenizOkcu/haze.git"
  },
  "bugs": {
    "url": "https://github.com/DenizOkcu/haze/issues"
  },
  "homepage": "https://github.com/DenizOkcu/haze#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "haze": "bin/haze.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc && node scripts/write-build-info.mjs",
    "dev:link": "node scripts/dev-link.mjs",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:knip": "knip",
    "typecheck": "tsc --noEmit",
    "context:report": "node --import tsx src/cli/contextReport.ts",
    "eval": "node scripts/run-evals.mjs",
    "release:verify": "node scripts/verify-release-metadata.mjs",
    "haze": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run lint && npm run build && npm audit --audit-level=high && npm run release:verify"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.56",
    "@ai-sdk/openai": "4.0.73",
    "@vscode/ripgrep": "1.18.0",
    "ai": "7.0.112",
    "cli-highlight": "2.1.11",
    "commander": "15.0.0",
    "defuddle": "^0.19.4",
    "fs-extra": "11.4.1",
    "ignore": "^7.0.10",
    "ink": "7.1.1",
    "ink-spinner": "5.0.0",
    "linkedom": "^0.18.13",
    "marked": "18.0.14",
    "react": "19.3.0",
    "strip-ansi": "7.2.0",
    "turndown": "^7.2.4",
    "wrap-ansi": "10.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "eslint": "^10.11.0",
    "ink-testing-library": "^4.0.0",
    "knip": "6.38.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
