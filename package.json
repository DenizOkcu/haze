{
  "name": "@denizokcu/haze",
  "version": "1.0.0",
  "description": "A minimal LLM harness for your terminal.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenizOkcu/haze.git"
  },
  "bugs": {
    "url": "https://github.com/DenizOkcu/haze/issues"
  },
  "homepage": "https://github.com/DenizOkcu/haze#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "haze": "bin/haze.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "context:report": "node --import tsx src/cli/contextReport.ts",
    "haze": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run lint && npm run build && npm audit --audit-level=high"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.25",
    "@ai-sdk/openai": "4.0.30",
    "@vscode/ripgrep": "1.18.0",
    "ai": "7.0.52",
    "cli-highlight": "2.1.11",
    "commander": "15.0.0",
    "defuddle": "^0.19.2",
    "fs-extra": "11.4.0",
    "ink": "7.1.1",
    "ink-spinner": "5.0.0",
    "linkedom": "^0.18.13",
    "marked": "18.0.9",
    "react": "19.2.8",
    "strip-ansi": "7.2.0",
    "turndown": "^7.2.4",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "eslint": "^10.8.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "4.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
