{
  "name": "@denizokcu/haze",
  "version": "1.7.11",
  "description": "A minimal LLM harness for your terminal.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenizOkcu/haze.git"
  },
  "bugs": {
    "url": "https://github.com/DenizOkcu/haze/issues"
  },
  "homepage": "https://github.com/DenizOkcu/haze#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "haze": "bin/haze.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc && node scripts/write-build-info.mjs",
    "dev:link": "node scripts/dev-link.mjs",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:knip": "knip",
    "typecheck": "tsc --noEmit",
    "context:report": "node --import tsx src/cli/contextReportCli.ts",
    "eval": "node scripts/run-evals.mjs",
    "bench:render": "node --expose-gc scripts/ink-render-benchmark.mjs .",
    "release:verify": "node scripts/verify-release-metadata.mjs",
    "haze": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run lint && npm run build && npm audit --audit-level=high && npm run release:verify",
    "eval:native": "node scripts/run-native-evals.mjs"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.92",
    "@ai-sdk/openai": "4.0.110",
    "@ai-sdk/openai-compatible": "3.0.86",
    "@inkjs/ui": "2.0.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@vscode/ripgrep": "1.18.0",
    "ai": "7.0.164",
    "commander": "15.0.0",
    "defuddle": "^0.19.6",
    "highlight.js": "^11.12.0",
    "ignore": "^7.0.14",
    "ink": "8.0.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "web-tree-sitter": "^0.23.2",
    "wrap-ansi": "10.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "^10.14.0",
    "ink-testing-library": "^4.0.0",
    "jscpd": "^5.4.2",
    "knip": "6.44.1",
    "lefthook": "^2.2.2",
    "strip-ansi": "7.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
