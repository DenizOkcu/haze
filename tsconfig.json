{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    // pnpm workspaces resolve deps through the .pnpm store via symlinks; without
    // preserveSymlinks every inferred export type referencing a dependency
    // becomes "not portable" against the store path and typecheck fails.
    "preserveSymlinks": true,
    // Node globals (process, Buffer, NodeJS namespace) are declared by
    // @types/node; include it explicitly rather than relying on another
    // package's types pulling it in transitively.
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
